# Preferred production room storage (Vercel Marketplace → Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel's Redis integration may instead supply KV_REST_API_URL and KV_REST_API_TOKEN.

# Realtime room-change notifications (Ably dashboard API key)
ABLY_API_KEY=
# Existing deployments using ABLY_API_Key are also supported.

# Optional legacy fallback when Upstash is not configured
DATABASE_URL=
